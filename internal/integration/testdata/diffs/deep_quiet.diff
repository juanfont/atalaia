+func TestNormalize(t *testing.T) {
+	cases := map[string]string{
+		"  Hello   World ": "hello world",
+		"MiXeD\tCase\nHere": "mixed case here",
+		"":                  "",
+	}
+	for in, want := range cases {
+		if got := Normalize(in); got != want {
+			t.Errorf("Normalize(%q) = %q, want %q", in, got, want)
+		}
+	}
+}
+
+func TestUpsertRequiresID(t *testing.T) {
+	s := New()
+	if err := s.Upsert(Entry{Body: "x"}); err == nil {
+		t.Fatal("want an error for an entry with no id")
+	}
+}
+
+func TestSearchMatchesAllTerms(t *testing.T) {
+	s := New()
+	_ = s.Upsert(Entry{ID: "1", Body: "the quick brown fox"})
+	_ = s.Upsert(Entry{ID: "2", Body: "a slow green turtle"})
+
+	got := s.Search([]string{"quick", "fox"})
+	if len(got) != 1 || got[0].ID != "1" {
+		t.Errorf("Search returned %+v", got)
+	}
+}
